# Адрес, по которому сервис виден снаружи (без завершающего слэша). Его же слушает Caddy:
# https://<домен> – Caddy сам получит сертификат; http://localhost:8088 – локально без HTTPS.
PUBLIC_URL=http://localhost:8088
# Необязательно: имена, с которых Caddy перенаправляет на PUBLIC_URL (www, прежний адрес) – через запятую
# с пробелом и в кавычках (deploy.sh читает .env оболочкой). Каждое должно указывать на сервер: для него
# тоже выпускается сертификат.
# REDIRECT_FROM="www.example.org, old.example.org"

# Keycloak («ФСП ID»): администратор master-реалма, консоль – ${PUBLIC_URL}/auth/admin/
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin

# База Keycloak (внутри compose, наружу не публикуется)
KC_DB_PASSWORD=change-me-db

# Секреты клиентов реалма fsp-id (подставляются в keycloak/fsp-id-realm.json при первом импорте).
# fsp-career – платформа команды; fsp-partner-demo – публичный демо-партнёр для показа согласий.
FSP_CAREER_CLIENT_SECRET=fsp-career-demo-secret
FSP_PARTNER_DEMO_SECRET=fsp-partner-demo-secret

# Сервисный аккаунт API реестра (fsp-registry-admin, роль manage-users): им API заводит пользователя
# ФСП ID для участника, созданного в песочнице стартовой страницы. На стенде – своё значение.
FSP_REGISTRY_ADMIN_SECRET=fsp-registry-admin-secret

# Платформа, на которую ведёт стартовая страница («проверьте на платформе»)
PLATFORM_URL=https://fsp2.ru

# Пароль всех синтетических спортсменов (логин – fsp-10001 … см. data/dataset.json)
FSP_DEMO_PASSWORD=fsp-demo-2026
