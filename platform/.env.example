# Скопировать в .env и заполнить. Значений-секретов в репозитории нет.
# Схема и проверка — src/server/env.ts.

# --- База (локально: scripts/db-local.sh create fsp_<lane>) ---
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/fsp_foundation
# Отдельная БД для integration-тестов (её очищают тесты!)
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/fsp_test_foundation

# --- Сессия: HMAC-подпись куки cid, не короче 32 символов ---
SESSION_SECRET=
# Страница /demo и /api/demo/login со списком демо-аккаунтов (для жюри). Выключить на проде
DEMO_LOGIN=true
# Публичный адрес приложения; redirect URI Яндекс ID = ${APP_URL}/api/auth/yandex/callback
APP_URL=http://localhost:3000
# Только стенд с HTTPS (docker-compose.prod.yml, docs/deploy.md): домен без схемы для Caddy;
# APP_URL при этом — https://<этот домен>
# SITE_ADDRESS=
# Необязательно: имена через запятую, с которых стенд перенаправляет на SITE_ADDRESS (www, прежний адрес)
# SITE_REDIRECT_FROM=
# Пароль на публичный адрес (без логина, страница /site-access). Пусто — стенд открыт; localhost не закрывается
SITE_PASSWORD=
# Или SHA-256 пароля (64 hex; на стенде задан в docker-compose.prod.yml и важнее SITE_PASSWORD)
SITE_PASSWORD_SHA256=

# --- Вход через Яндекс ID (oauth.yandex.ru). Пусто — кнопка неактивна, работает демо-вход ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- Привязка ФСП ID (OIDC/Keycloak, R-FSP-01). Нужны ISSUER и SECRET; без них — встроенный мок ФСП ID (/api/fsp-id/realms/fsp) ---
# Симулятор команды: issuer https://111-88-114-206.sslip.io/auth/realms/fsp-id, API https://111-88-114-206.sslip.io/api/v1
# Клиент fsp-career там конфиденциальный: без секрета обмен кода — 401. В симуляторе зарегистрирован redirect https://fsp2.ru/api/fsp-id/callback
FSP_OIDC_ISSUER=
FSP_OIDC_CLIENT_ID=fsp-career
FSP_OIDC_CLIENT_SECRET=
FSP_API_URL=

# --- LLM ---
# stub | yandex | openai-chat
LLM_PROVIDER=stub
# Только для stub: извлекатель размечает резюме словарём каталога (демо без ключей; в тестах — false)
LLM_STUB_DEMO=false
LLM_MAX_CONCURRENCY=8
LLM_TIMEOUT_MS=40000
LLM_MAX_RETRIES=2
# Бюджет токенов на кандидата в сутки (вход + выход)
LLM_DAILY_TOKEN_BUDGET=200000

# Yandex AI Studio (Responses API) — для LLM_PROVIDER=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
# false — модель без function calling, client включает план В (JSON в тексте)
YANDEX_SUPPORTS_TOOLS=true

# OpenAI-совместимый Chat Completions (Cloud.ru, vLLM, Yandex OpenAI-compat) — для LLM_PROVIDER=openai-chat
OPENAI_CHAT_BASE_URL=
OPENAI_CHAT_API_KEY=
OPENAI_CHAT_MODEL=
# Имя в журнале AgentRun (cloudru, yandex-openai, vllm)
OPENAI_CHAT_NAME=
OPENAI_CHAT_SUPPORTS_TOOLS=true
OPENAI_CHAT_SUPPORTS_JSON_SCHEMA=true
# Стримить ответы консультанта и помощника (stream: true). false — если бэкенд не умеет SSE
OPENAI_CHAT_STREAM=true
# Yandex OpenAI-compat (DeepSeek): OPENAI_CHAT_BASE_URL=https://llm.api.cloud.yandex.net/v1,
# OPENAI_CHAT_API_KEY=<ключ API>, YANDEX_FOLDER_ID=<каталог> — заголовки и gpt://-URI подставятся сами

# --- Голосовой ввод в чате ---
# auto — Yandex SpeechKit при YANDEX_API_KEY + YANDEX_FOLDER_ID (ключу нужна роль ai.speechkit-stt.user), иначе распознаёт браузер (Web Speech API)
# yandex | browser | off. Аудио на сервере не хранится.
STT_PROVIDER=auto

# --- Озвучка ответов компаньона (3D-аватар в чате) ---
# auto — Yandex SpeechKit TTS v1 при YANDEX_API_KEY + YANDEX_FOLDER_ID (ключу нужна роль ai.speechkit-tts.user), иначе off
# yandex | off. Аудио не хранится; в синтез уходит только текст ответа компаньона (≤ 1000 знаков).
TTS_PROVIDER=auto
# Голос и амплуа SpeechKit v1: marina|jane|omazh (жен.), ermil|zahar|filipp|madi_ru (муж.); neutral|friendly|good
TTS_VOICE=marina
# Второй голос: реплики работодателя в защите проекта (кандидат слышит их не голосом ИИ)
TTS_VOICE_EMPLOYER=filipp
TTS_EMOTION=neutral
TTS_SPEED=1.1
# mp3 (любой браузер) | oggopus (меньше, Safari < 17 не декодирует)
TTS_FORMAT=mp3

# lane call: папка данных созвонов (аудио кандидата — calls/<id>/*.wav). В Docker — том app-data (/app/data)
CALL_DATA_DIR=./data
# Оригиналы файлов кандидата (резюме, дипломы): <UPLOAD_DIR>/<candidateId>/<sha256>. В Docker — тот же том app-data
UPLOAD_DIR=./data/uploads
# Созвонов кандидата за 24 часа (по виду созвона); 0 — без лимита. Дефолт в коде 5; на стенде ставим 0.
CALL_DAILY_LIMIT=5
# Срок хранения аудио созвона, дней (ADR 0005): потом файлы удаляет фоновая очистка, транскрипт остаётся
CALL_RECORDING_RETENTION_DAYS=90

# --- Веб-поиск агента (инструмент web_search, Yandex Search API v2) ---
# auto — включён при YANDEX_API_KEY + YANDEX_FOLDER_ID (сервисному аккаунту нужна роль search-api.webSearch.user), off — выключен.
# Только обезличенные запросы (персональные данные отсекает код), ≤ 2 за ход и ≤ 10 за разговор, ~0,5 ₽ за запрос.
WEB_SEARCH=auto

# --- Сборщик ---
# Необязательный токен GitHub (поднимает лимит REST)
GITHUB_TOKEN=
# true — профили только из фикстур, без сети (демо-стенд, тесты)
COLLECTOR_FIXTURES=false

# --- Автопроверка проектов (сервис runner, ADR 0003; platform/runner/README.md) ---
# Адрес runner: в compose задаётся сам (http://runner:8090); локально — RUNNER_LOCAL=1 npx tsx runner/src/main.ts
RUNNER_URL=
# Общий секрет app <-> runner, openssl rand -hex 32. Пусто — runner отвечает 503, проверка проектов выключена
RUNNER_TOKEN=

# --- Тест на грейд (docs/decisions/0002-grade-test.md) ---
# true — интервалы смены грейда/пересдачи в минутах вместо дней (стенд жюри)
TEST_DEMO_INTERVALS=true
# true — индекс честности high задерживает категорию до подтверждающего теста; false — только считается
TEST_INTEGRITY=true

# --- Почта (Mailpit на стенде): вход по email, уведомления о приглашениях ---
# smtp — боевой режим: письма на реальные ящики через SMTP-провайдера (локально — Mailpit).
# log — только локально и в тестах: письма в лог сервера, никуда не уходят.
# На стенде без SMTP регистрация жюри по почте невозможна (демо-профили /demo работают)
# На стенде (docker compose) SMTP_HOST/SMTP_PORT пусты или не заданы — письма идут в Mailpit внутри стенда;
# для реальных ящиков задать хост, порт и логин провайдера (SMTP_HOST=localhost ниже — только для локальной разработки).
MAIL_PROVIDER=smtp
MAIL_FROM=ФСП Карьера <no-reply@fsp-career.local>
SMTP_HOST=localhost
SMTP_PORT=1025
# true — TLS с первого байта (порт 465). Mailpit — false
SMTP_SECURE=false
# Пусто — без авторизации (Mailpit)
SMTP_USER=
SMTP_PASSWORD=

# --- ATS (концепт R-X-02): подписанный вебхук о смене статуса приглашения (HMAC-SHA256, X-FSP-Signature) ---
# Оба значения пусты — вебхук не отправляется. В теле нет имени и контактов кандидата.
ATS_WEBHOOK_URL=
ATS_WEBHOOK_SECRET=
