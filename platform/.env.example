# Скопировать в .env и заполнить. Значений-секретов в репозитории нет.
# Схема и проверка – src/server/env.ts.

# --- База (локально: scripts/db-local.sh create fsp_<lane>) ---
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/fsp_foundation
# Отдельная БД для integration-тестов (её очищают тесты!)
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/fsp_test_foundation

# --- Сессия: HMAC-подпись куки cid, не короче 32 символов ---
SESSION_SECRET=
# Страница /demo и /api/demo/login со списком демо-аккаунтов (для жюри). Выключить на проде
DEMO_LOGIN=true
# Публичный адрес приложения; redirect URI Яндекс ID = ${APP_URL}/api/auth/yandex/callback
APP_URL=http://localhost:3000
# Только стенд с HTTPS (docker-compose.prod.yml, docs/deploy.md): домен без схемы для Caddy;
# APP_URL при этом – https://<этот домен>
# SITE_ADDRESS=
# Необязательно: имена через запятую, с которых стенд перенаправляет на SITE_ADDRESS (www, прежний адрес)
# SITE_REDIRECT_FROM=
# Пароль на публичный адрес (без логина, страница /site-access). Пусто – стенд открыт; localhost не закрывается
SITE_PASSWORD=
# Или SHA-256 пароля (64 hex; можно держать в docker-compose.prod.yml, важнее SITE_PASSWORD; на стенде сейчас не задан)
SITE_PASSWORD_SHA256=
# Отладочная панель и /api/dev/* (src/server/devtools/guard.ts): работают только при NODE_ENV не production
# и Host localhost / 127.0.0.1 / [::1]. false | 0 | off – выключить и там (например, чтобы локально ушло настоящее письмо).
# Не задана или другое значение – включены
# DEVTOOLS=false
# Второй локальный dev-сервер из той же папки: свой каталог сборки вместо .next (next.config.ts, distDir).
# Читается напрямую из process.env
# NEXT_DIST_DIR=.next-second

# --- Вход через Яндекс ID (oauth.yandex.ru). Пусто – кнопка в окне входа скрыта, работает демо-вход ---
# Приложение для авторизации пользователей, права login:info и login:email.
# Redirect URI должен совпадать с ${APP_URL}/api/auth/yandex/callback; настройка – README.md.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- Привязка ФСП ID (OIDC/Keycloak, R-FSP-01). Нужны ISSUER и SECRET; без них – встроенный мок ФСП ID (/api/fsp-id/realms/fsp) ---
# Симулятор команды: issuer https://fsp-russia2.ru/auth/realms/fsp-id, API https://fsp-russia2.ru/api/v1
# Клиент fsp-career там конфиденциальный: без секрета обмен кода – 401. В симуляторе зарегистрирован redirect https://fsp2.ru/api/fsp-id/callback
FSP_OIDC_ISSUER=
FSP_OIDC_CLIENT_ID=fsp-career
FSP_OIDC_CLIENT_SECRET=
FSP_API_URL=
# Только с симулятором: подсказка у кнопок входа и привязки – чем войти (логины и демо-пароль вымышленных спортсменов
# со стартовой страницы симулятора), например: логин fsp-10001 … fsp-10120, пароль <FSP_DEMO_PASSWORD симулятора>. Пусто – без подсказки
FSP_OIDC_DEMO_HINT=

# --- LLM ---
# stub | yandex | openai-chat
LLM_PROVIDER=stub
# Только для stub: извлекатель размечает резюме словарём каталога (демо без ключей; в тестах – false)
LLM_STUB_DEMO=false
LLM_MAX_CONCURRENCY=8
LLM_TIMEOUT_MS=40000
LLM_MAX_RETRIES=2
# Бюджет токенов на кандидата в сутки (вход + выход)
LLM_DAILY_TOKEN_BUDGET=200000

# Yandex AI Studio (Responses API) – для LLM_PROVIDER=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
# false – модель без function calling, client включает план В (JSON в тексте)
YANDEX_SUPPORTS_TOOLS=true

# OpenAI-совместимый Chat Completions (Cloud.ru, vLLM, Yandex OpenAI-compat) – для LLM_PROVIDER=openai-chat
OPENAI_CHAT_BASE_URL=
OPENAI_CHAT_API_KEY=
OPENAI_CHAT_MODEL=
# Имя в журнале AgentRun (cloudru, yandex-openai, vllm)
OPENAI_CHAT_NAME=
OPENAI_CHAT_SUPPORTS_TOOLS=true
OPENAI_CHAT_SUPPORTS_JSON_SCHEMA=true
# Стримить ответы консультанта и помощника (stream: true). false – если бэкенд не умеет SSE
OPENAI_CHAT_STREAM=true
# Yandex OpenAI-compat (DeepSeek): OPENAI_CHAT_BASE_URL=https://llm.api.cloud.yandex.net/v1,
# OPENAI_CHAT_API_KEY=<ключ API>, YANDEX_FOLDER_ID=<каталог> – заголовки и gpt://-URI подставятся сами

# --- Запасная модель (если основная не ответила после ретраев: 5xx/429, таймаут, сеть) ---
# Следующие 60 с запросы идут сразу в запасную, потом основная пробуется снова. Пусто – запасной нет.
# Qwen3.6 в Yandex AI Studio: BASE_URL=https://ai.api.cloud.yandex.net/v1, MODEL=qwen3.6-35b-a3b,
# FOLDER_ID=<каталог модели, если не YANDEX_FOLDER_ID>, EXTRA_BODY={"reasoning_effort":"none"}
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_FOLDER_ID=
LLM_FALLBACK_NAME=
LLM_FALLBACK_EXTRA_BODY=
# Отдельная модель для созвонов; не задана – основная. Тройка BASE_URL+API_KEY+MODEL задаётся вместе.
LLM_CALL_BASE_URL=
LLM_CALL_API_KEY=
LLM_CALL_MODEL=
LLM_CALL_FOLDER_ID=
LLM_CALL_NAME=
LLM_CALL_EXTRA_BODY=

# --- Голосовой ввод в чате ---
# auto – Yandex SpeechKit при YANDEX_API_KEY + YANDEX_FOLDER_ID (ключу нужна роль ai.speechkit-stt.user), иначе распознаёт браузер (Web Speech API)
# yandex | openai | browser | off. Аудио на сервере не хранится.
# openai – запасной провайдер: OpenAI-совместимый /audio/transcriptions (vLLM whisper-large-v3, Selectel Dedicated Inference);
# нужны STT_OPENAI_BASE_URL (с /v1) и STT_OPENAI_API_KEY (Bearer), модель – STT_OPENAI_MODEL (по умолчанию whisper-large-v3). `auto` openai не выбирает.
STT_PROVIDER=auto
# STT_OPENAI_BASE_URL=
# STT_OPENAI_API_KEY=
# STT_OPENAI_MODEL=

# --- Озвучка ответов компаньона (3D-аватар в чате) ---
# auto – Yandex SpeechKit TTS v1 при YANDEX_API_KEY + YANDEX_FOLDER_ID (ключу нужна роль ai.speechkit-tts.user), иначе off
# yandex | elevenlabs | off (elevenlabs – только явно, auto его не выбирает). Аудио не хранится; в синтез уходит только текст ответа компаньона (≤ 1000 знаков).
TTS_PROVIDER=auto
# Голос и амплуа SpeechKit v1: marina|jane|omazh (жен.), ermil|zahar|filipp|madi_ru (муж.); neutral|friendly|good
TTS_VOICE=marina
# Второй голос: реплики работодателя в защите проекта (кандидат слышит их не голосом ИИ)
TTS_VOICE_EMPLOYER=filipp
TTS_EMOTION=neutral
TTS_SPEED=1.1
# mp3 (любой браузер) | oggopus (меньше, Safari < 17 не декодирует)
TTS_FORMAT=mp3
# ElevenLabs (TTS_PROVIDER=elevenlabs, только синтез; распознавание остаётся SpeechKit). Текст реплик ИИ уходит за рубеж.
# Голос – voice_id (GET /v1/voices), не имя. Формат ответа всегда mp3; TTS_SPEED зажимается в 0.7–1.2, TTS_VOICE/EMOTION/FORMAT не используются.
# Со стенда в РФ api.elevenlabs.io отвечает 302 на страницу гео-блокировки – ELEVENLABS_PROXY_URL (HTTP-прокси вне РФ, только для ElevenLabs)
# или ELEVENLABS_BASE_URL на реверс-прокси. ELEVENLABS_MODEL_CALL – модель для созвонов (realtime), напр. eleven_flash_v2_5.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE=
# ELEVENLABS_VOICE_EMPLOYER=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_MODEL_CALL=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# ELEVENLABS_PROXY_URL=

# lane call: папка данных созвонов (аудио кандидата – calls/<id>/*.wav). В Docker – том app-data (/app/data)
CALL_DATA_DIR=./data
# Оригиналы файлов кандидата (резюме, дипломы): <UPLOAD_DIR>/<candidateId>/<sha256>. В Docker – тот же том app-data
UPLOAD_DIR=./data/uploads
# Созвонов кандидата за 24 часа (по виду созвона); 0 – без лимита. Дефолт в коде 5; на стенде ставим 0.
CALL_DAILY_LIMIT=5
# Вопрос ИИ в созвоне стримится и озвучивается по предложениям (SSE utterance_delta); false – ответ целиком, как раньше
CALL_STREAMING=true
# Срок хранения аудио созвона, дней (ADR 0005): потом файлы удаляет фоновая очистка, транскрипт остаётся
CALL_RECORDING_RETENTION_DAYS=90

# --- Веб-поиск агента (инструмент web_search, Yandex Search API v2) ---
# auto – включён при YANDEX_API_KEY + YANDEX_FOLDER_ID (сервисному аккаунту нужна роль search-api.webSearch.user), off – выключен.
# Только обезличенные запросы (персональные данные отсекает код), ≤ 2 за ход и ≤ 10 за разговор, ~0,5 ₽ за запрос.
WEB_SEARCH=auto

# --- OCR картинок и сканов PDF (Yandex Vision OCR) ---
# Включён при OCR_API_KEY (отдельный ключ со scope yc.ai.vision.execute; YANDEX_API_KEY без него получает 403)
# и каталоге OCR_FOLDER_ID (иначе YANDEX_FOLDER_ID). OCR_PROVIDER=off – выключить.
OCR_PROVIDER=
OCR_API_KEY=
OCR_FOLDER_ID=

# --- Сборщик ---
# Необязательный токен GitHub (поднимает лимит REST)
GITHUB_TOKEN=
# true – профили только из фикстур, без сети (демо-стенд, тесты)
COLLECTOR_FIXTURES=false

# --- Автопроверка проектов (сервис runner, ADR 0003; platform/runner/README.md) ---
# Адрес runner: в compose задаётся сам (http://runner:8090); локально – RUNNER_LOCAL=1 npx tsx runner/src/main.ts
RUNNER_URL=
# Общий секрет app <-> runner, openssl rand -hex 32. Пусто – runner отвечает 503, проверка проектов выключена
RUNNER_TOKEN=
# Корень шаблонов проектов (src/server/project/templates.ts). Не задан – <cwd>/project-templates
# (cwd = platform/ локально и /app в образе). Читается напрямую из process.env
# PROJECT_TEMPLATES_DIR=

# --- Тест на грейд (docs/decisions/0002-grade-test.md) ---
# true – интервалы смены грейда/пересдачи в минутах вместо дней (стенд жюри)
TEST_DEMO_INTERVALS=true
# true – индекс честности high задерживает категорию до подтверждающего теста; false – только считается
TEST_INTEGRITY=true
# silent (по умолчанию) – high не задерживает категорию и ничего не раскрывает кандидату; confirm – high ведёт к подтверждающему тесту
TEST_INTEGRITY_ACTION=silent
# Лимиты длины основной фазы теста на грейд «min,max» (5…20). Пусто – дефолт policy 7–10. 10,14 → κ ретеста 0,461 при 10,5 задания
# (docs/validation-results.md, «Длина теста и надёжность»). Меняет и уже начатые попытки текущей версии – менять между прогонами.
TEST_ITEM_LIMITS=
# true – слой «только для жюри» (счётчики сигналов, сдвиг ловушки, разбор индекса на итоге); на проде false
JURY_INSIGHTS=true
# true – в выдаче работодателю при индексе high категория из теста не учитывается, пока её не подтвердит
# подтверждающий тест или созвон с разбором теста («объяснил сам»); false – индекс только метка, порядок не меняется
TEST_INTEGRITY_RANKING=true

# --- Почта (Mailpit на стенде): вход по email, уведомления о приглашениях ---
# smtp – боевой режим: письма на реальные ящики через SMTP-провайдера (локально – Mailpit).
# log – только локально и в тестах: письма в лог сервера, никуда не уходят.
# На стенде без SMTP регистрация жюри по почте невозможна (демо-профили /demo работают)
# На стенде (docker compose) SMTP_HOST/SMTP_PORT пусты или не заданы – письма идут в Mailpit внутри стенда;
# для реальных ящиков задать хост, порт и логин провайдера (SMTP_HOST=localhost ниже – только для локальной разработки).
MAIL_PROVIDER=smtp
MAIL_FROM=MESHWORK <no-reply@meshwork.local>
SMTP_HOST=localhost
SMTP_PORT=1025
# true – TLS с первого байта (порт 465). Mailpit – false
SMTP_SECURE=false
# Пусто – без авторизации (Mailpit)
SMTP_USER=
SMTP_PASSWORD=

# --- ATS (концепт R-X-02): подписанный вебхук о смене статуса приглашения (HMAC-SHA256, X-FSP-Signature) ---
# Оба значения пусты – вебхук не отправляется. В теле нет имени и контактов кандидата.
ATS_WEBHOOK_URL=
ATS_WEBHOOK_SECRET=
