{
  "name": "fsp-career-platform",
  "version": "0.1.0",
  "private": true,
  "description": "ФСП Карьера: платформа и карьерный консультант (E-01)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/mediapipe-assets.mjs",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/mediapipe-assets.mjs",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project components",
    "test:integration": "vitest run --project integration",
    "test:runner": "vitest run --project runner",
    "e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:local": "bash scripts/db-local.sh",
    "eval:test": "tsx eval/test/run.ts",
    "eval:test-personas": "tsx eval/test/personas.ts",
    "eval:test-integrity": "tsx eval/test/integrity.ts",
    "eval:call": "tsx eval/call/personas.ts",
    "eval:defense": "tsx eval/defense/personas.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "@prisma/client": "^6.19.2",
    "@react-three/fiber": "9.8.1",
    "mammoth": "^1.12.3",
    "motion": "13.4.4",
    "next": "^15.5.9",
    "node-html-parser": "^7.0.1",
    "openai": "^6.46.0",
    "pdfkit": "^0.20.2",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "three": "0.186.1",
    "undici": "^7.19.0",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^5.0.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.9",
    "jsdom": "^26.1.0",
    "prisma": "^6.19.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.7"
  }
}
