// Схема E-01 «Карьерный консультант». Пишется foundation целиком; лейны меняют
// только аддитивно и только в своей секции (`// lane: <name>`), миграции
// собирает интегратор. План: fsp/docs/epics/E-01-plan.md § «Prisma-модели».

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// lane: foundation — кандидат, категория, журнал вызовов LLM
// =============================================================================

/// Направления (ADR 0003, дополнение 10.10): ai и engineering — lane directions.
enum Specialization {
  backend
  frontend
  ai
  engineering
}

enum Grade {
  junior
  middle
  /// Сверх ТЗ (ADR 0003, дополнение 10.10 16:15; ADR-0002 «Senior и пул по подкатегориям»)
  senior
}

/// Состояние привязки ФСП (R-FSP-03: сценарий «нет истории ФСП» обязателен).
enum FspState {
  not_linked
  no_achievements
  unavailable
  linked
}

/// Категорию даёт только тест (R-M-01). Другие источники не предусмотрены.
enum CategorySource {
  test
}

enum LlmPurpose {
  consultant
  extractor
  evaluator
  interviewer
  smoke
  /// Помощник работодателя (lane emp-agent)
  employer_assistant
  /// lane call: интервьюер и слепой оценщик квалифицирующего созвона (ADR 0003, ступень 1)
  call_interviewer
  call_evaluator
  /// lane interview: интервьюер ИИнтервью (docs/competency-model.md); оценщик — call_evaluator
  interview_interviewer
  /// Зарезервировано лейном call для соседей (ADR 0003), чтобы не делать вторую enum-миграцию:
  /// defense-room — вопросы по коду кандидата (QLC); project — условие проекта и рубрика пожеланий.
  defense_qlc
  project_spec
  project_rubric
  /// lane memory: извлечение фактов о собеседнике из реплики для памяти консультанта
  consultant_memory
}

model Candidate {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  specialization Specialization?
  consentAt      DateTime?
  fspState       FspState        @default(not_linked)
  /// Демо-кандидат из сида (вход через /api/demo/login).
  isDemo         Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  categories          CandidateCategory[]
  uploads             Upload[]
  sources             Source[]
  claims              Claim[]
  conversations       Conversation[]
  agentRuns           AgentRun[]
  recommendations     Recommendation[]
  invitations         Invitation[]
  defenseSessions     DefenseSession[]
  /// lane project: взятые задания ленты и сабмиты проектов (ADR 0003, ступень 2)
  projectAssignments  ProjectAssignment[]
  projectSubmissions  ProjectSubmission[]
  /// lane memory: память консультанта
  memories            ConsultantMemory[]
  /// lane auth: аккаунт входа (null у старых демо-кандидатов до первого демо-входа)
  user                User?
  /// lane employer: настройка приватности (R-C-13) — true: не показывать в подборке и поиске работодателей
  hiddenFromEmployers Boolean               @default(false)
  /// lane onboarding: анкета онбординга (цель, грейд, стек, формат, зарплата)
  profile             CandidateProfile?
  /// lane test: попытки теста на грейд
  testAttempts        TestAttempt[]
  /// lane invite-contact: способ связи для работодателя — почта или Telegram (server/contact.ts).
  /// Открывается компании только после accepted; null — показываем почту аккаунта, если она не служебная.
  contact             String?
  /// lane call: созвоны (квалифицирующий и защита проекта) и вопросы работодателей кандидату
  callSessions        CallSession[]
  employerQuestions   EmployerQuestion[]
  /// lane instructions: как работает консультант кандидата (скиллы и свои инструкции)
  consultantSettings  ConsultantSettings?
  /// lane directions: подкатегория направления из справочника Subcategory ("ai.llm-apps"), выбор в
  /// онбординге необязателен. Без FK — справочник проверяется кодом (server/directions).
  subcategoryId       String?
  /// lane astra-favorites: private employer bookmarks
  savedByUsers        UserSavedCandidate[]
  /// lane consent: возражения против оценки (ст. 16 152-ФЗ)
  objections          AssessmentObjection[]
}

model CandidateCategory {
  id             String         @id @default(cuid())
  candidateId    String
  candidate      Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  specialization Specialization
  grade          Grade
  source         CategorySource @default(test)
  confirmedAt    DateTime       @default(now())
  /// Подкатегория (Subcategory.id, lane directions; ADR 0003, дополнение 10.10 15:50): категория =
  /// направление × подкатегория × грейд. null — категория до теста на подкатегорию (демо, старые попытки).
  subcategoryId  String?

  @@index([candidateId])
}

/// Журнал каждого вызова LLM (пишет llm/client.ts). Цифры для критерия валидации.
model AgentRun {
  id             String     @id @default(cuid())
  purpose        LlmPurpose
  provider       String
  model          String
  latencyMs      Int
  inputTokens    Int        @default(0)
  outputTokens   Int        @default(0)
  ok             Boolean
  /// null — запрос без schema; true/false — прошёл ли JSON валидацию.
  jsonValid      Boolean?
  error          String?
  /// Сколько попыток ушло (1 + ретраи).
  attempts       Int        @default(1)
  queueWaitMs    Int        @default(0)
  candidateId    String?
  candidate      Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  conversationId String?
  createdAt      DateTime   @default(now())

  @@index([candidateId, createdAt])
  @@index([purpose, createdAt])
}

// =============================================================================
// lane: collector — загрузки и внешние источники
// =============================================================================

enum SourceKind {
  resume
  document
  url
  github
  codeforces
  stackoverflow
  fsp
  chat
}

model Upload {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  filename    String
  mime        String
  sha256      String
  size        Int
  /// ExtractedDoc (server/collector/types.ts)
  extracted   Json?
  /// ExtractedDoc.flags
  flags       Json?
  /// Оригинал файла: <UPLOAD_DIR>/<storageKey>, ключ = "<candidateId>/<sha256>" (только серверные id). null — загружен до хранения оригиналов.
  storageKey  String?
  createdAt   DateTime  @default(now())

  @@unique([candidateId, sha256])
}

model Source {
  id                String     @id @default(cuid())
  candidateId       String
  candidate         Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  kind              SourceKind
  /// URL или handle профиля
  origin            String
  /// ExtractedDoc — снимок на момент чтения (он же кэш GitHub/Codeforces)
  snapshot          Json
  /// Подтверждено ли владение аккаунтом (для third_party у codeforces/fsp)
  ownershipVerified Boolean    @default(false)
  fetchedAt         DateTime   @default(now())

  claims Claim[]

  @@index([candidateId, kind, origin])
}

// =============================================================================
// lane: claims — каталог и утверждения профиля
// =============================================================================

enum CatalogSpecialization {
  backend
  frontend
  common
  /// lane directions: записи ai.* / eng.* каталога
  ai
  engineering
}

enum EvidenceLevel {
  self_reported
  artifact
  platform
  third_party
}

enum ClaimStatus {
  proposed
  confirmed
  edited
  rejected
}

enum Confidence {
  low
  medium
  high
}

/// Поля CatalogEntry (server/claims/types.ts).
model ClaimCatalog {
  /// ID вида "be.idempotency"
  id             String                @id
  specialization CatalogSpecialization
  statement      String
  grades         Grade[]
  /// 1 | 2 | 3
  weight         Int
  proof          String[]
  markers        String[]
  limits         String
  /// Веса по грейдам {"J":1,"M":2,"S":3} (каталог § 7: сигнатура Middle — M ≥ 2 и M > J)
  weights        Json?
  /// Стек/технологии записи (массив строк или объект — как в claims-catalog.json)
  stack          Json?
  /// ID смежных записей каталога
  adjacent       String[]              @default([])
  /// Версия каталога, из которой загружена запись
  catalogVersion String?

  claims Claim[]
}

model Claim {
  id             String        @id @default(cuid())
  candidateId    String
  candidate      Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  catalogId      String
  catalog        ClaimCatalog  @relation(fields: [catalogId], references: [id])
  statement      String
  /// Ставит код по типу источника (ADR-0001), не LLM и не кандидат.
  level          EvidenceLevel
  quote          String
  /// "cv.pdf#p2:l14", "github:user/repo#README:l3"
  sourceRef      String
  sourceKind     SourceKind
  sourceId       String?
  source         Source?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  confidence     Confidence?
  limits         String
  /// string[]
  suggestedProof Json
  status         ClaimStatus   @default(proposed)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  confirmedAt    DateTime?

  defenseSessions DefenseSession[]

  @@index([candidateId, status])
  @@index([candidateId, catalogId])
}

// =============================================================================
// lane: agent — диалог консультанта
// =============================================================================

enum MessageRole {
  system
  user
  assistant
  tool
}

model Conversation {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  title       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  messages Message[]

  @@index([candidateId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  /// ToolCall[] (server/llm/types.ts) — у assistant
  toolCalls      Json?
  /// у tool
  toolCallId     String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// =============================================================================
// lane: recommend — рекомендации, компании, вакансии, банк заданий, приглашения
// =============================================================================

enum RecommendationKind {
  test
  task
  target
}

enum InvitationStatus {
  sent
  /// lane employer: кандидат открыл приглашение
  viewed
  accepted
  declined
}

model Recommendation {
  id          String             @id @default(cuid())
  candidateId String
  candidate   Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  kind        RecommendationKind
  payload     Json
  reason      String
  accepted    Boolean?
  createdAt   DateTime           @default(now())

  @@index([candidateId, kind])
}

model Company {
  id                String             @id @default(cuid())
  name              String
  description       String?
  isDemo            Boolean            @default(true)
  vacancies         Vacancy[]
  /// lane auth: представители компании
  employers         EmployerProfile[]
  /// lane employer
  invitations       Invitation[]
  /// lane onboarding: ИНН (проверен по контрольной сумме; реестр — демо), отрасль, контакт (R-E-01)
  inn               String?
  industry          String?
  contact           String?
  /// lane call: вопросы компании кандидатам (очередь асинхронной дозащиты)
  employerQuestions EmployerQuestion[]
}

model Vacancy {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title           String
  specialization  Specialization
  grade           Grade
  /// ₽, обязательные
  salaryFrom      Int
  salaryTo        Int
  /// { catalogId: string; weight: number }[]
  needs           Json
  description     String?
  createdAt       DateTime       @default(now())
  /// lane employer + onboarding: чем занимается команда (R-E-02)
  teamDescription String?
  /// lane employer + onboarding: стек свободными метками ("Go", "PostgreSQL"); needs — проекция на каталог
  stack           String[]       @default([])
  /// lane employer: потребность закрыта/в архиве — в кабинете отдельно, подборка не строится
  archivedAt      DateTime?
  updatedAt       DateTime?      @updatedAt
  /// lane directions: подкатегория потребности ("backend.web-api"), необязательна. Без FK — см. Candidate.
  subcategoryId   String?

  invitations  Invitation[]
  /// lane project: проектное задание потребности (ADR 0003, ступень 2)
  projectTasks ProjectTask[]
  /// lane astra-favorites: private candidate bookmarks
  savedByUsers UserSavedVacancy[]

  @@index([specialization, grade])
}

/// Банк заданий: рекомендуются только отсюда.
model Task {
  /// slug вида "task:payment-retry"
  id          String   @id
  title       String
  family      String
  grade       Grade
  catalogIds  String[]
  description String?
}

model Invitation {
  id                String           @id @default(cuid())
  /// lane employer: null — приглашение без привязки к потребности (R-E-05)
  vacancyId         String?
  vacancy           Vacancy?         @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  candidateId       String
  candidate         Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status            InvitationStatus @default(sent)
  /// lane invite-contact: вилка предложения, ₽ в месяц (ТЗ 2.2: «зарплата от–до»); заменила salaryOffer
  salaryFrom        Int
  salaryTo          Int
  message           String?
  createdAt         DateTime         @default(now())
  /// lane employer: компания-отправитель (null только у строк до миграции без вакансии)
  companyId         String?
  company           Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// lane employer: кто отправил
  employerProfileId String?
  employerProfile   EmployerProfile? @relation(fields: [employerProfileId], references: [id], onDelete: SetNull)
  viewedAt          DateTime?
  respondedAt       DateTime?

  @@index([candidateId, status])
  @@index([companyId, createdAt])
}

// =============================================================================
// lane: defense — защита утверждения
// =============================================================================

enum DefenseStatus {
  active
  completed
  abandoned
}

model DefenseSession {
  id          String        @id @default(cuid())
  claimId     String
  claim       Claim         @relation(fields: [claimId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status      DefenseStatus @default(active)
  /// Вердикт оценщика (рубрика A-02), null до завершения
  verdict     Json?
  createdAt   DateTime      @default(now())
  completedAt DateTime?

  turns DefenseTurn[]

  @@index([candidateId, claimId])
}

model DefenseTurn {
  id        String         @id @default(cuid())
  sessionId String
  session   DefenseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  index     Int
  question  String
  answer    String?
  createdAt DateTime       @default(now())

  @@unique([sessionId, index])
}

// =============================================================================
// lane: auth — аккаунты, внешние входы, роль, согласие (docs/decisions/0001-auth-yandex-id.md)
// =============================================================================

/// pending — вошёл, роль ещё не выбрана в онбординге.
enum UserRole {
  pending
  candidate
  employer
}

/// Аккаунт входа. Профиль роли — отдельной записью (Candidate или EmployerProfile),
/// чтобы не трогать связи Candidate с остальными таблицами.
model User {
  id          String     @id @default(cuid())
  role        UserRole   @default(pending)
  name        String
  /// Из Яндекса; null, если почту не отдали. Не уникален: аккаунты по почте не склеиваем.
  email       String?
  isDemo      Boolean    @default(false)
  /// Онбординг завершён (ставит markOnboarded). null → после входа редирект на /onboarding.
  onboardedAt DateTime?
  candidateId String?    @unique
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  accounts           AuthAccount[]
  employerProfile    EmployerProfile?
  consents           Consent[]
  /// lane onboarding: где человек остановился в онбординге
  onboarding         OnboardingState?
  /// lane call: участие в созвонах (работодатель в комнате защиты)
  callParticipations CallParticipant[]

  // lane: email-auth — вход по почте и паролю (R-D-04; ADR 0001, дополнение 10.10).
  // Уникальность почты — через AuthAccount(provider = "email", providerAccountId = почта в нижнем регистре).
  /// scrypt-хэш пароля `scrypt$N$r$p$salt$hash`; null — аккаунт без пароля (Яндекс, демо).
  passwordHash                 String?
  /// Почта подтверждена кодом из письма. Без этого вход по паролю закрыт.
  emailVerifiedAt              DateTime?
  authCodes                    AuthCode[]
  // lane astra: notification read cursors are independent for each account role.
  candidateNotificationsReadAt DateTime?
  employerNotificationsReadAt  DateTime?
  /// lane astra-favorites: bookmarks are private to the account, not its company
  savedVacancies               UserSavedVacancy[]
  savedCandidates              UserSavedCandidate[]
}

// =============================================================================
// lane: astra-favorites — persistent private bookmarks for both account roles
// =============================================================================
model UserSavedVacancy {
  userId    String
  vacancyId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancy   Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@id([userId, vacancyId])
  @@index([vacancyId])
}

model UserSavedCandidate {
  userId      String
  candidateId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@id([userId, candidateId])
  @@index([candidateId])
}

/// Внешний аккаунт (Яндекс ID). Токены провайдера не храним.
model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  lastLoginAt       DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model EmployerProfile {
  id                     String                 @id @default(cuid())
  userId                 String                 @unique
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId              String
  company                Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdAt              DateTime               @default(now())
  /// lane employer
  invitations            Invitation[]
  /// lane emp-agent: разговоры с помощником работодателя
  assistantConversations EmployerConversation[]
  /// lane memory: память помощника по подбору
  memories               ConsultantMemory[]

  @@index([companyId])
}

/// Факт согласия на обработку ПДн (R-C-14, 152-ФЗ): версия текста + время. Записи не удаляются.
/// lane consent (ADR 0005): вид согласия. Одна строка — один акт согласия; отзыв — revokedAt.
enum ConsentKind {
  /// Г1: обработка ПДн для подбора (регистрация). Отзыв = удаление аккаунта.
  pd_processing
  /// Г2: запись голоса и транскрипта ИИ-созвона
  call_recording
  /// Г3: оценка ответов ИИ (ст. 16 152-ФЗ, с правом возражения) — нужна для теста, созвона, защиты
  ai_assessment
  /// Г4: показ профиля работодателям под псевдонимом (без него hiddenFromEmployers = true)
  employer_visibility
  /// Г6: обезличенные данные для проверки качества теста и оценщика
  research
  /// Г7: рассылки (рассылок нет — галочка хранится и ни на что не влияет)
  marketing
  /// Г5: раскрытие имени и контактов конкретному работодателю (context.invitationId)
  identity_disclosure
  /// Работодатель: акцепт условий для работодателей (оферта, /employer-terms)
  employer_offer
  /// Работодатель: обязательство использовать данные кандидатов только для найма
  employer_data_obligation
}

model Consent {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       ConsentKind @default(pd_processing)
  version    String
  acceptedAt DateTime    @default(now())
  /// Отзыв: строка остаётся в истории. Активное согласие — последнее по kind без revokedAt.
  revokedAt  DateTime?
  /// Привязка согласия (identity_disclosure: { invitationId }).
  context    Json?

  @@index([userId, acceptedAt])
  @@index([userId, kind, revokedAt])
}

enum ObjectionSubject {
  grade_test
  call
  defense
}

enum ObjectionStatus {
  open
  answered
}

/// lane consent (ст. 16 152-ФЗ): возражение кандидата против автоматической оценки. Срок ответа — 30 дней.
/// Работодателю не показывается.
model AssessmentObjection {
  id          String           @id @default(cuid())
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  subject     ObjectionSubject
  /// Что оспаривается: TestAttempt/CandidateCategory (grade_test), CallSession (call), DefenseSession или CallSession kind=defense (defense)
  subjectId   String
  text        String
  status      ObjectionStatus  @default(open)
  answer      String?
  createdAt   DateTime         @default(now())
  answeredAt  DateTime?

  @@index([candidateId, createdAt])
  @@index([status, createdAt])
}

// =============================================================================
// lane: onboarding — анкета кандидата и состояние онбординг-чата (E-02)
// =============================================================================

/// Цель кандидата (R-C-04).
enum CandidateGoal {
  job_search
  market_watch
  grade_confirm
}

enum WorkFormat {
  remote
  hybrid
  office
  relocation
}

/// Участие в соревнованиях ФСП со слов кандидата (не подтверждение: подтверждает только привязка ФСП ID).
enum FspParticipation {
  prize
  participant
  none
}

/// Анкета онбординга, 1–1 с Candidate. Специализация — в Candidate.specialization.
model CandidateProfile {
  candidateId      String            @id
  candidate        Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  goal             CandidateGoal?
  /// Предполагаемый грейд (R-C-05); категорию даёт только тест.
  claimedGrade     Grade?
  stack            String[]          @default([])
  workFormats      WorkFormat[]      @default([])
  /// ₽ в месяц
  salaryMin        Int?
  salaryExpected   Int?
  fspParticipation FspParticipation?
  city             String?
  updatedAt        DateTime          @updatedAt
}

/// Состояние онбординг-чата: текущий шаг, ответы, пропуски. «Настроить позже» и
/// перезагрузка продолжают с места. Сценарий — server/onboarding/scenario.ts.
model OnboardingState {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// id шага, на котором человек сейчас (null — первый незакрытый)
  stepId    String?
  /// { [stepId]: значение ответа }
  answers   Json     @default("{}")
  skipped   String[] @default([])
  /// Сгенерированные реплики помощника { [stepId]: текст } — чтобы перезагрузка не звала LLM повторно
  lines     Json     @default("{}")
  /// Служебное: id созданных вакансий работодателя { [grade]: vacancyId }
  meta      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// lane: test — адаптивный тест на грейд (docs/decisions/0002-grade-test.md)
// =============================================================================

enum TestAttemptStatus {
  active
  passed
  not_confirmed
  abandoned
  /// Грейд подтверждён по ответам, но индекс честности high: категория не выдаётся до подтверждающего теста (ADR-0002, 11.10)
  needs_confirmation
}

/// Шаблон-генератор задания. Код генератора — src/server/test/generators; здесь —
/// рабочие параметры IRT (стартовые экспертные, правятся калибровкой) и экспозиция.
model TaskTemplate {
  /// ID генератора: "be.sql-rowcount"
  id             String         @id
  /// ID задания каталога (claims-catalog «Доказывается»: task:<id>)
  taskId         String
  title          String
  specialization Specialization
  grade          Grade
  catalogIds     String[]
  format         String
  /// Дискриминация 2PL
  irtA           Float
  /// Сложность 2PL (шкала θ)
  irtB           Float
  /// expert | calibrated
  paramsSource   String         @default("expert")
  /// Сколько раз показан (экспозиционный контроль, R-T-01)
  exposure       Int            @default(0)
  updatedAt      DateTime       @updatedAt

  items TestItem[]
}

model TestAttempt {
  id                String            @id @default(cuid())
  candidateId       String
  candidate         Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  specialization    Specialization
  /// Заявленный грейд (R-C-05, R-C-06)
  grade             Grade
  status            TestAttemptStatus @default(active)
  /// full | demo
  mode              String            @default("full")
  /// Seed попытки: порядок и параметры заданий воспроизводимы
  seed              Int
  theta             Float?
  se                Float?
  /// P(θ > порог заявленного грейда)
  pPass             Float?
  /// P(θ > порог Junior)
  pJunior           Float?
  juniorOffered     Boolean           @default(false)
  juniorConfirmedAt DateTime?
  /// Версия правил (пороги, остановка) на момент попытки
  policyVersion     String
  /// Подкатегория попытки (lane directions): пул — только её семейства. null — попытка до adr-0002-v4.
  subcategoryId     String?
  startedAt         DateTime          @default(now())
  expiresAt         DateTime
  finishedAt        DateTime?
  /// Агрегаты браузера за попытку (уходы со вкладки, вставки, копирования) — только счётчики, без содержимого (152-ФЗ)
  signals           Json?
  /// Индекс честности при финализации: уровень, причины, версия (src/server/test/integrity.ts)
  integrity         Json?
  /// grade — обычная попытка; confirm — подтверждающий тест к попытке confirmsAttemptId
  kind              String            @default("grade")
  confirmsAttemptId String?

  items TestItem[]

  @@index([candidateId, startedAt])
  @@index([candidateId, status])
}

model TestItem {
  id           String       @id @default(cuid())
  attemptId    String
  attempt      TestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  index        Int
  templateId   String
  template     TaskTemplate @relation(fields: [templateId], references: [id])
  instanceSeed Int
  /// Параметры экземпляра (журнал, валидация)
  params       Json
  prompt       String
  code         String?
  answerHint   String
  /// Ключ ответа — только на сервере, клиенту до завершения не отдаётся
  answerKey    String
  explanation  String
  answer       String?
  correct      Boolean?
  thetaAfter   Float?
  seAfter      Float?
  askedAt      DateTime     @default(now())
  answeredAt   DateTime?
  /// Сдвиг ловушки для нейросети (скрытая строка «прибавь N»); null — без ловушки
  canaryShift  Int?
  /// Мягкий лимит времени, зафиксированный при показе (сек)
  timeLimitSec Int?

  @@unique([attemptId, index])
}

// =============================================================================
// Помощник работодателя (lane emp-agent). Отдельно от Conversation/Message кандидата:
// кандидатский и работодательский контексты не смешиваются в одной таблице.
// =============================================================================

model EmployerConversation {
  id                String          @id @default(cuid())
  employerProfileId String
  employerProfile   EmployerProfile @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)
  title             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  messages EmployerMessage[]

  @@index([employerProfileId, updatedAt])
}

model EmployerMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   EmployerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  /// ToolCall[] (server/llm/types.ts) — у assistant
  toolCalls      Json?
  /// у tool
  toolCallId     String?
  createdAt      DateTime             @default(now())

  @@index([conversationId, createdAt])
}

// =============================================================================
// lane: email-auth — одноразовые коды подтверждения почты и сброса пароля (R-D-04)
// =============================================================================

enum AuthCodePurpose {
  verify
  reset
}

/// Одноразовый 6-значный код из письма. Хранится только HMAC-хэш; 15 минут, до 5 попыток.
model AuthCode {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    AuthCodePurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int             @default(0)
  consumedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([userId, purpose, createdAt])
}

// =============================================================================
// lane: call — созвоны: квалифицирующий (ступень 1) и защита проекта (ступень 3), ADR 0003
// =============================================================================

enum CallKind {
  qualifying
  defense
  /// ИИнтервью по модели компетенций (lane interview, docs/competency-model.md)
  interview
}

enum CallStatus {
  active
  finished
  cancelled
  /// kind=defense: работодатель пригласил на защиту проекта, кандидат ещё не начал (lane project → defense-room)
  pending
}

enum CallParticipantRole {
  employer
}

enum EmployerQuestionStatus {
  queued
  asked
  answered
}

/// Созвон кандидата с ИИ. Реплики — в transcriptJson (роли ai | candidate | employer, таймкоды),
/// аудио кандидата — файлы на диске (CALL_DATA_DIR/<audioPath>), не в БД.
model CallSession {
  id                  String             @id @default(cuid())
  candidateId         String
  candidate           Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  kind                CallKind
  /// kind=defense: сабмит проекта (lane project)
  projectSubmissionId String?
  projectSubmission   ProjectSubmission? @relation(fields: [projectSubmissionId], references: [id], onDelete: SetNull)
  status              CallStatus         @default(active)
  startedAt           DateTime           @default(now())
  finishedAt          DateTime?
  /// TranscriptEntry[] (server/call/types.ts)
  transcriptJson      Json               @default("[]")
  /// Папка с аудио кандидата относительно CALL_DATA_DIR: "calls/<id>"; null — аудио не записывалось
  audioPath           String?
  /// Вердикт оценщика (qualifying — карта глубины, server/call/types.ts CallVerdict)
  verdictJson         Json?
  /// Версия согласия на запись созвона, под которой шёл звонок
  policyVersion       String
  /// Сколько раз запускался оценщик (finish): каждый запуск — 3–6 вызовов LLM, повторы после 503 ограничены
  finishAttempts      Int                @default(0)

  participants CallParticipant[]
  questions    EmployerQuestion[]

  @@index([candidateId, kind, status])
  @@index([projectSubmissionId])
}

/// Участник созвона кроме кандидата (работодатель в комнате защиты, lane defense-room).
model CallParticipant {
  id            String              @id @default(cuid())
  callSessionId String
  callSession   CallSession         @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          CallParticipantRole @default(employer)
  joinedAt      DateTime            @default(now())
  leftAt        DateTime?
  /// Работодатель «замьютил ИИ»: ИИ не вступает, пока не разрешат
  aiMuted       Boolean             @default(false)

  @@index([callSessionId])
  @@index([userId])
}

/// Вопрос работодателя кандидату: задаётся в созвоне сейчас или копится до следующего входа.
model EmployerQuestion {
  id                      String                 @id @default(cuid())
  companyId               String
  company                 Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidateId             String
  candidate               Candidate              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  projectSubmissionId     String?
  text                    String
  askedAt                 DateTime               @default(now())
  answeredInCallSessionId String?
  answeredInCallSession   CallSession?           @relation(fields: [answeredInCallSessionId], references: [id], onDelete: SetNull)
  status                  EmployerQuestionStatus @default(queued)

  @@index([candidateId, status])
  @@index([companyId, candidateId])
}

// =============================================================================
// lane: project — ступень 2 «проект под работодателя» (ADR 0003, «Дополнение 10.10»: лента заданий).
// Шаблоны лежат на диске (platform/project-templates/<subcategory>/<grade>/<id>/template.json),
// ProjectTemplate — их снимок для связей и выборок. subcategoryId — строка без relation
// (модель Subcategory у лейна directions, связывает интегратор); specialization — строка, не enum,
// чтобы не конфликтовать с расширением enum Specialization (ai, engineering).
// =============================================================================

enum ProjectTaskVisibility {
  /// В ленте обезличенных заданий кандидатам подходящего направления.
  open
  /// Только кандидатам с приглашением по этой потребности.
  invited
}

enum ProjectSubmissionStatus {
  submitted
  running
  checked
  failed
}

enum ProjectAssignmentStatus {
  /// Взято, сдачи ещё нет — считается в лимит PROJECT_MAX_ACTIVE.
  active
  /// Сдано (есть сабмит) — в лимит не считается.
  submitted
}

model ProjectTemplate {
  /// = template.json id, например "be-webapi-junior-booking"
  id              String   @id
  subcategoryId   String
  specialization  String
  grade           Grade
  title           String
  contractMd      String
  /// Путь шаблона от platform/project-templates, например "backend.web-api/junior/be-webapi-junior-booking"
  dirRef          String
  hiddenTestsRef  String
  visibleTestsRef String
  stackTags       String[] @default([])
  /// Образ runner: node20 | python312
  image           String
  timeBudgetMin   Int
  updatedAt       DateTime @updatedAt

  tasks ProjectTask[]
}

model ProjectTask {
  id                 String                @id @default(cuid())
  /// Одна потребность — одно задание (перегенерация меняет условие, пока нет сабмитов).
  vacancyId          String                @unique
  vacancy            Vacancy               @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  templateId         String
  template           ProjectTemplate       @relation(fields: [templateId], references: [id])
  specialization     String
  grade              Grade
  subcategoryId      String?
  visibility         ProjectTaskVisibility @default(open)
  /// { title, domainStory, requirements[], acceptance[], notes, source: llm|fallback }
  specJson           Json
  /// Обязательные критерии работодателя — ID каталога утверждений
  requiredCatalogIds String[]              @default([])
  wishesText         String?
  /// { criteria: [{ id, text, catalogId?, source: required|wish }] }
  rubricJson         Json
  deadlineDays       Int?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  assignments ProjectAssignment[]
  submissions ProjectSubmission[]

  @@index([specialization, grade, visibility])
}

/// Кандидат взял задание из ленты (лимит активных — PROJECT_MAX_ACTIVE).
model ProjectAssignment {
  id            String                  @id @default(cuid())
  projectTaskId String
  projectTask   ProjectTask             @relation(fields: [projectTaskId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     Candidate               @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status        ProjectAssignmentStatus @default(active)
  takenAt       DateTime                @default(now())
  /// После срока взятое, но не сданное задание не держит слот лимита.
  expiresAt     DateTime

  @@unique([projectTaskId, candidateId])
  @@index([candidateId, status])
}

model ProjectSubmission {
  id                  String                  @id @default(cuid())
  projectTaskId       String
  projectTask         ProjectTask             @relation(fields: [projectTaskId], references: [id], onDelete: Cascade)
  candidateId         String
  candidate           Candidate               @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  repoUrl             String
  commitSha           String?
  aiLogText           String?
  status              ProjectSubmissionStatus @default(submitted)
  /// { tests: {passed, total, score}, lint, rubric, platformOwnedViolations[] }
  resultJson          Json?
  /// Задание runner (GET /run/{jobId}); null — stub-режим
  runnerJobId         String?
  /// Почему failed — для кандидата, без деталей скрытых тестов
  error               String?
  /// Приглашение «на защиту» (POST /api/employer/project-submissions/{id}/invite-to-defense)
  defenseInvitationId String?
  /// Сдано после срока задания (ProjectAssignment.expiresAt) — сдавать можно, работодатель видит пометку.
  late                Boolean                 @default(false)
  submittedAt         DateTime                @default(now())
  checkedAt           DateTime?

  defenseSessions CallSession[]

  @@index([projectTaskId, submittedAt])
  @@index([candidateId, submittedAt])
}

// =============================================================================
// lane: defense-room — защита проекта (ступень 3, ADR 0003): план QLC-вопросов сессии.
// =============================================================================

/// План защиты проекта: вопросы из кода (QLC) и вопросы работодателя, курсор, блокировка хода.
model DefenseRoomPlan {
  id            String    @id @default(cuid())
  callSessionId String    @unique
  /// `PlanItem[]` (src/server/defense-room/types.ts)
  itemsJson     Json
  cursor        Int       @default(0)
  /// Сводка репозитория и источников вопросов: { repoUrl, commitSha, files, generator: llm|fallback }
  sourceJson    Json
  /// Ход в обработке (LLM): не принимать второй параллельно; протухает через 90 с.
  lockedAt      DateTime?
  createdAt     DateTime  @default(now())
}

// =============================================================================
// lane: memory — память консультанта («Что я о тебе знаю», решение владельца 10.10)
// =============================================================================

enum MemorySource {
  /// консультант запомнил из свободного разговора
  chat
  /// человек добавил сам
  user
}

/// Заметка о собеседнике. Владелец — ровно один из candidateId / employerProfileId (проверяет код).
/// Ответы знакомства сюда не копируются: они производные (OnboardingState), source «onboarding» только в UI.
model ConsultantMemory {
  id                String           @id @default(cuid())
  candidateId       String?
  candidate         Candidate?       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  employerProfileId String?
  employerProfile   EmployerProfile? @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)
  text              String           @db.VarChar(200)
  source            MemorySource
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([candidateId, createdAt])
  @@index([employerProfileId, createdAt])
}

/// lane instructions: настройки ИИ-консультанта кандидата (решение владельца 10.10).
/// Меняют только стиль и фокус ответов консультанта; на подборку, категорию, тест не влияют.
model ConsultantSettings {
  candidateId String    @id
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// id из server/consultant/skills.ts
  skills      String[]  @default([])
  /// Свои инструкции кандидата, ≤ 500 символов (проверка — в API)
  custom      String?   @db.VarChar(500)
  updatedAt   DateTime  @updatedAt
}

// =============================================================================
// lane: directions — справочник подкатегорий направлений (ADR 0003, дополнение 10.10; R-T-05)
// =============================================================================

enum SubcategoryStatus {
  /// Тест по подкатегории доступен (банк ≥ 8 семейств) и/или есть шаблон проекта
  active
  /// В справочнике, тест пока недоступен
  planned
}

/// Подкатегория направления. id вида "backend.web-api" (направление.подкатегория).
/// Сид — prisma/seed/directions.ts из src/lib/directions.ts (карта research/25 владельца).
model Subcategory {
  id             String            @id
  specialization Specialization
  title          String
  description    String
  status         SubcategoryStatus @default(planned)
  order          Int               @default(0)

  @@index([specialization, order])
}
